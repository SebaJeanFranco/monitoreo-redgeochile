# Copiá este archivo a .env (sin el .example) y pegá la URL de tu Worker
# desplegado. Ver dga-worker/README.md para desplegarlo.
#
# Sin esta variable, el dashboard sigue funcionando pero lee el archivo
# estático public/alertas-rios.json (el que generás manualmente con
# scripts/fetch_alertas_dga.py) en vez de actualizarse solo al abrir la página.

VITE_DGA_WORKER_URL=https://alertas-rios-dga.TU-USUARIO.workers.dev
